.panel {
    background-color: rgb(128, 128, 128);
    -unity-background-image-tint-color: rgb(0, 0, 0);
    opacity: 1;
    display: flex;
    align-items: center;
}

.hide {
    opacity: 1;
}

.menu {
    align-items: center;
    background-color: rgba(132, 72, 72, 0);
}

.unity-button {
    flex-grow: 1;
    width: 400px;
    height: 50px;
}
